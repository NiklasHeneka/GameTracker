# Copy to .env and fill in. .env is git-ignored and read only by the Rust backend.

# IGDB (required) — https://dev.twitch.tv/console/apps
# Create an application, set the OAuth redirect URL to http://localhost,
# then copy the Client ID and generate a Client Secret.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# IsThereAnyDeal (optional) — https://isthereanydeal.com/apps/my/
# Without it, prices fall back to CheapShark, which needs no key.
ITAD_API_KEY=

# PlatPrices (optional, PlayStation prices) — https://platprices.com/developers.php
# Free tier: 1000 requests/month, non-commercial use only.
PLATPRICES_API_KEY=

# Steam Web API (optional, library import) — https://steamcommunity.com/dev/apikey
# Your Steam profile and game details must be public.
STEAM_API_KEY=
